# Server configuration
HOST=127.0.0.1
PORT=8080

# Database connection URL (required)
DATABASE_URL=dbname=memoir_development

# API write token remains required until ownership cutover.
API_TOKEN=asdfasdf

# Browser accounts (HTTPS required outside localhost)
APP_ORIGIN=http://localhost:3000
SESSION_TTL=168h

# SMTP account emails. Use starttls or tls with a remote SMTP server.
SMTP_ADDRESS=localhost:1025
SMTP_FROM=memoir@localhost
SMTP_TLS_MODE=none
SMTP_USERNAME=
SMTP_PASSWORD=

# AWS S3 Configuration for artwork storage (required)
AWS_BUCKET=memoir-artwork-development
AWS_REGION=eu-west-1
AWS_KEY=
AWS_SECRET=

# PostHog log export (optional; disabled without a project token)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
OTEL_SERVICE_NAME=memoir
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
