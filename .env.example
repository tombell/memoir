# Server configuration
HOST=127.0.0.1
PORT=8080

# Database connection URL (required)
DATABASE_URL=postgresql://memoir:memoir@127.0.0.1:5432/memoir_development?sslmode=disable

# API authentication token (required)
API_TOKEN=local-development-token

# AWS S3 configuration (all values required at startup).
# These dummy credentials allow database-only local development.
# Replace them with credentials for a development bucket before uploading.
AWS_BUCKET=memoir-artwork-development
AWS_REGION=eu-west-1
AWS_KEY=development-key
AWS_SECRET=development-secret
